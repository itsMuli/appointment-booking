# Database
MONGODB_URL=your_mongodb_connection_string
PORT=5000

# JWT
JWT_SECRET=your_jwt_secret_key

# Admin Credentials
ADMIN_EMAIL=admin@infinitynailsalon.com
ADMIN_PASSWORD=admin123

# Email Configuration (Optional - password reset / booking emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Infinity Nail Salon <no-reply@infinitynailsalon.com>"
# Alternate names used by mailer helper:
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Cloudinary Configuration (Optional - for image uploads)
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_api_secret

# --- WhatsApp Cloud API (Meta) ---
# 1. Meta Developer app → WhatsApp → API Setup
# 2. Copy temporary or permanent token + Phone number ID
# 3. Webhook URL: https://YOUR-RENDER-HOST/api/whatsapp/webhook
# 4. Verify token: any secret string you choose (must match WHATSAPP_VERIFY_TOKEN)
# 5. Subscribe to "messages"
# 6. WHATSAPP_JOAN_PHONE = Joan's WhatsApp in international digits (e.g. 2547XXXXXXXX)
# Note: first message outside the 24h window may need an approved template
# (booking_request / booking_result). In-session Approve/Reject replies use buttons.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=infinity_wa_verify
WHATSAPP_JOAN_PHONE=2547XXXXXXXX

# --- Instagram Graph API (Blog gallery) ---
# 1. Convert IG to Business/Creator and link a Facebook Page
# 2. Meta app → Instagram Graph API → long-lived Page token
# 3. INSTAGRAM_BUSINESS_ACCOUNT_ID = IG user id (not @username)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Node Environment
NODE_ENV=development
